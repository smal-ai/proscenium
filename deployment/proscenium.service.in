# TEMPLATE ONLY. Replace @CHECKOUT@ and @CONFIG_HOME@ with reviewed absolute paths.
# No automatic pairing output, execution Resume, model-service or editor lifecycle.
[Unit]
Description=Proscenium private host-native studio
After=network.target

[Service]
Type=simple
WorkingDirectory=@CHECKOUT@
Environment=XDG_CONFIG_HOME=@CONFIG_HOME@
Environment=PYTHONUNBUFFERED=1
UMask=0077
ExecStart=@CHECKOUT@/.venv/bin/python -m proscenium --origin http://127.0.0.1:8765 --frontend-dir @CHECKOUT@/apps/frontend/dist
Restart=no
KillMode=process
TimeoutStopSec=30
# Child/native ownership is managed by the composed adapter, not group-wide killing.
# No unmeasured MemoryMax is imposed. No privileges/sandbox that break native tools.

[Install]
WantedBy=default.target
