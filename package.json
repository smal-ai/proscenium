{
  "name": "proscenium-workspace",
  "private": true,
  "version": "0.1.0",
  "engines": {"node": ">=22.12.0"},
  "workspaces": ["apps/frontend"],
  "scripts": {
    "generate": "node scripts/generate-types.mjs",
    "build": "npm run build --workspace apps/frontend",
    "typecheck": "npm run typecheck --workspace apps/frontend",
    "lint": "eslint apps/frontend/src scripts/*.mjs"
  },
  "devDependencies": {
    "@github/copilot": "1.0.112",
    "@playwright/test": "1.65.1",
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "json-schema-to-typescript": "15.0.4",
    "typescript-eslint": "8.72.2",
    "typescript": "5.9.3"
  },
  "overrides": {"minimatch": "11.0.1"}
}
